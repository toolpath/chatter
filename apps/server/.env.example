# Settings for the server. Copy this file to .env to use it. Each one is optional.

# The port of the server and the API (default 3001)
# PORT=3001

# The SQLite database: machines, users and logins, settings, upload history, machine state periods, and alerts (default data/chatter.db)
# DATABASE_PATH=data/chatter.db

# The built web app, to serve it from the server too (the Docker image sets it)
# WEB_DIR=../web/dist

# VictoriaMetrics, which keeps the machine history (default http://localhost:8428)
# VICTORIA_METRICS_URL=http://localhost:8428

# The internal port where vmalert sends alerts (default 3002 on 127.0.0.1).
# On Linux with docker-compose.dev.yml, set ALERT_HOST=0.0.0.0 so the vmalert container can reach it.
# ALERT_PORT=3002
# ALERT_HOST=127.0.0.1

# The folder where Chatter writes the vmalert file of the alert rules (default data/alert-rules, next to the database).
# vmalert reads every .yml file in it.
# ALERT_RULES_DIR=data/alert-rules

# vmalert, which Chatter asks to read the rules again after a change (default http://localhost:8880)
# VMALERT_URL=http://localhost:8880

# Proxy addresses or ranges to trust, comma-separated, for HTTPS behind a proxy (default: none).
# When it is set, it wins over the list in Settings > HTTPS and proxy.
# TRUST_PROXY=192.168.1.10
