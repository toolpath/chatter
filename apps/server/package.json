    "hono": "^4.13.16",
    "koffi": "^2.15.0",
    "node-opcua-certificate-manager": "^2.187.16",
    "node-opcua-client": "^2.187.16",
    "ping": "^0.4.4",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/ping": "^0.4.4",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.1.0"
  }
